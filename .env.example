# ==============================================================================
# StudyAI Environment Configuration Example
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local or production secrets to Git.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Authentication & PostgreSQL Database
# Retrieve these from your Supabase Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key is strictly server-side (for admin tasks & migrations)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Storage Bucket for user uploaded PDFs and Screenshots
NEXT_PUBLIC_STORAGE_BUCKET=study_materials

# ------------------------------------------------------------------------------
# AI Provider Configuration (Anthropic Claude API or alternative)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Optional: Preferred language default ('en' | 'bn')
DEFAULT_LANGUAGE=en
